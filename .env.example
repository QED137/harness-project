# Copy to .env and fill in. .env is git-ignored; this file is committed as documentation.
# Never put these values into the sandbox container.

# Option A: OpenAI (paid per token; set a monthly spending limit in the OpenAI dashboard)
OPENAI_API_KEY=
# Model name from the OpenAI models page. It determines cost: the evaluation makes many calls.
OPENAI_MODEL=

# Option B: free local model via Ollama. Start it with: docker compose up -d ollama
# then: docker compose exec ollama ollama pull qwen3:4b
# and use these three lines instead of the two above:
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=qwen3:4b
